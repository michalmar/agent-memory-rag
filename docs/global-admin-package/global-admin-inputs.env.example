# Copy this file to global-admin-inputs.env and fill every required value.
# It contains identifiers and decisions, never passwords, tokens, or client secrets.

# Dedicated Azure CLI profile for this deployment.
AZURE_CONFIG_DIR="$HOME/.azure-365-global-admin"
COPILOT_HOME="$HOME/.copilot"
DEPLOYMENT_RUN_ID=""
SECURE_EVIDENCE_DIR=""

# Immutable target and actor IDs.
TARGET_TENANT_ID=""
TARGET_SUBSCRIPTION_ID=""
DEPLOYER_OBJECT_ID=""

# Target naming and placement.
LOCATION=""
SEARCH_LOCATION=""
RESOURCE_GROUP="rg-agent-memory-rag"
NAME_PREFIX="agmem"
ENVIRONMENT_NAME=""
APP_NAME=""
TAG_ENVIRONMENT=""
TAG_OWNER=""
VNET_ADDRESS_SPACE="10.42.0.0/16"

# Capacity-approved model and service choices.
CHAT_MODEL_NAME="gpt-4o-mini"
CHAT_MODEL_VERSION="2024-07-18"
CHAT_MODEL_SKU="GlobalStandard"
CHAT_MODEL_CAPACITY="30"
EMBEDDING_MODEL_NAME="text-embedding-3-large"
EMBEDDING_MODEL_VERSION="1"
EMBEDDING_MODEL_SKU="Standard"
EMBEDDING_MODEL_CAPACITY="30"
DIRECTIVE_MODEL_NAME="gpt-5.6-sol"
DIRECTIVE_MODEL_VERSION="2026-07-09"
DIRECTIVE_MODEL_SKU="GlobalStandard"
DIRECTIVE_MODEL_CAPACITY="250"
SEARCH_SKU="basic"
DIRECTIVE_STORAGE_REPLICATION_TYPE="LRS"

# "fresh" lets Terraform create the model. "adopt" requires the full ARM
# resource ID below and imports that deployment before the first plan.
DIRECTIVE_MODEL_MODE="fresh"
DIRECTIVE_MODEL_IMPORT_ID=""

# Terraform assigns deployment-time data roles to the signed-in user. This must
# be explicitly approved before a Global Administrator performs the apply.
RETAIN_TERRAFORM_DEPLOYER_DATA_ROLES="false"

# Set after scripts/create_entra_app.sh completes.
ENTRA_CLIENT_ID=""
ENTRA_API_SCOPE=""

# Enterprise application assignments. Use target-tenant object IDs.
DIRECTIVE_SOURCE_USER_IDS=""
DIRECTIVE_SOURCE_GROUP_IDS=""

# Agent 365 is optional. Set true only after its service principal and licensing
# prerequisites have been confirmed in the target tenant.
AGENT365_ENABLED="false"
AGENT365_LICENSED_USER_UPN=""

# Unique target azd environment names and immutable release identifiers.
SUPPORT_AZD_ENVIRONMENT=""
DIRECTIVE_AZD_ENVIRONMENT=""
PROMPT_AGENT_RELEASE_ID=""
DIRECTIVE_AGENT_RELEASE_ID=""
APP_IMAGE_TAG=""
SUPPORT_IMAGE_TAG=""
DIRECTIVE_IMAGE_TAG=""
INGESTION_RELEASE_ID=""

# Filled after Hosted Agent deployment.
SUPPORT_AGENT_PRINCIPAL_ID=""
DIRECTIVE_AGENT_PRINCIPAL_ID=""
PROJECT_AGENT_PRINCIPAL_ID=""
